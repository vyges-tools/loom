# The command floor a generated-SDC flow uses (LLM4SDC, DAC 2026, Table 1): every one appears once
# or more. Synthetic constraints for an imaginary block; no design is implied.
create_clock -name core_clk -period 2.5 -waveform {0 1.25} [get_ports clk]
create_generated_clock -name div2_clk -source [get_ports clk] -divide_by 2 [get_pins div_reg/Q]
create_clock -name io_clk -period 10 [get_ports io_clk]
set_clock_groups -asynchronous -group {core_clk div2_clk} -group {io_clk}
set_clock_latency -source 0.3 [get_clocks core_clk]
set_clock_latency 0.15 [get_clocks core_clk]
set_clock_transition 0.05 [get_clocks core_clk]
set_clock_uncertainty -setup 0.1 [get_clocks core_clk]
set_clock_uncertainty -hold 0.02 [get_clocks core_clk]
set_input_delay -clock core_clk -max 0.8 [get_ports {din* en}]
set_input_delay -clock core_clk -min 0.1 [get_ports {din* en}]
set_output_delay -clock core_clk 0.7 [get_ports dout*]
set_output_delay -clock io_clk 2.0 [get_ports io_out]
set_input_transition 0.08 [get_ports {din* en}]
set_load 0.012 [get_ports dout*]
set_max_capacitance 0.2 [current_design]
set_min_capacitance 0.001 [get_ports dout*]
set_max_fanout 16 [current_design]
set_max_transition 0.4 [current_design]
set_false_path -from [get_ports rst_n]
set_multicycle_path -setup 2 -from [get_clocks core_clk] -to [get_clocks div2_clk]
set_multicycle_path -hold 1 -from [get_clocks core_clk] -to [get_clocks div2_clk]
